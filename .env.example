# ============================================================
# Bot Trading MT5 - Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
#
# Usage:
#   1. Copy: cp .env.example .env
#   2. Edit .env with your real values
#   3. Or put your OpenAI API key in key_api.txt (also gitignored)
# ============================================================

# OpenAI API Key (required for AI trading mode)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# AI Model to use (default: gpt-4o-mini)
AI_MODEL_NAME=gpt-4o-mini

# AI Endpoint (default: OpenAI Responses API)
AI_ENDPOINT=https://api.openai.com/v1/responses

# MetaTrader 5 Configuration (optional - MT5 uses its own login)
# MT5 account credentials are managed directly in the MT5 terminal
# Do NOT hardcode them here or in Python files
